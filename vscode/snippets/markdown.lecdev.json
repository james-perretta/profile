{
	"v-click": {
		"prefix": "vclick",
		"body": [
			"<v-click>",
			"$1",
			"</v-click>"
		]
	},
	"v-clicks": {
		"prefix": "vclicks",
		"body": [
			"<v-clicks>",
			"$1",
			"</v-clicks>"
		]
	},
	"tscode": {
		"prefix": "tscode",
		"body": [
			"```typescript",
			"$1",
			"```"
		]
	},
	"tsrun": {
		"prefix": "tsrun",
		"body": [
			"```typescript {monaco-run} {height:'auto'}",
			"$1",
			"```"
		]
	},
	"twocol": {
		"prefix": "twocol",
		"body": [
			"<div style=\"display: flex\">",
			"<div style=\"width: 50%\">",
			"",
			"$1",
			"",
			"</div>",
			"",
			"<div style=\"border-left: 1px solid teal; margin: 0 1em\"></div>",
			"",
			"<div style=\"width: 50%\">",
			"",
			"$2",
			"",
			"</div>",
			"</div>"
		]
	},
	"noformat": {
		"prefix": "noformat",
		"body": [
			"<!-- prettier-ignore-start -->",
			"$1",
			"<!-- prettier-ignore-end -->",
		]
	},
	"div": {
		"prefix": "div",
		"body": "<div>$1</div>"
	},
	"excalidraw": {
		"prefix": "excalidraw",
		"body": "<Excalidraw drawFilePath=\"./$1.excalidraw.json\"/>"
	},
	"Comment": {
		"prefix": "comment",
		"body": [
			"<!-- $1 -->"
		],
		"description": "Add a comment tag. Useful for adding an inline comment when you don't want to comment the whole line."
	}
	// Place your snippets for markdown here. Each snippet is defined under a snippet name and has a prefix, body and 
	// description. The prefix is what is used to trigger the snippet and the body will be expanded and inserted. Possible variables are:
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. Placeholders with the 
	// same ids are connected.
	// Example:
	// "Print to console": {
	// 	"prefix": "log",
	// 	"body": [
	// 		"console.log('$1');",
	// 		"$2"
	// 	],
	// 	"description": "Log output to console"
	// }
}
